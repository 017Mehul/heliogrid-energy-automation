# Required for persistent storage (Render PostgreSQL external connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Render Postgres normally requires TLS; set to disable only for a trusted local database
PGSSLMODE=require
# Safe defaults: public submissions are stored; external side effects are off
DEMO_MODE=true
ENABLE_REAL_INTEGRATIONS=false
APP_ORIGIN=https://heliogrid-energy.themglabs.com
# Required in production for the daily Vercel cron retention job; use a long random secret
CRON_SECRET=
# Optional; only used when ENABLE_REAL_INTEGRATIONS=true
AUTOMATION_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
HUBSPOT_ACCESS_TOKEN=
SLACK_WEBHOOK_URL=
BOOKING_URL=
